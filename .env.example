POLYGON_RPC=
POLYMARKET_START_BLOCK=33605403

# Public Kalshi live-data scanner settings
SCAN_INTERVAL_SECONDS=300
SCAN_LIMIT=250
SCAN_TOP=25
MIN_VOLUME=10000
MAX_SPREAD=0.08
SNAPSHOT_PATH=output/live/market_snapshots.jsonl
PORT=8080
LOG_LEVEL=INFO

# Authenticated Kalshi access. Keep these in your deployment secret store.
KALSHI_ENVIRONMENT=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/run/secrets/kalshi_private_key.pem
# Alternative for secret stores that inject text. Encode line breaks as \\n.
KALSHI_PRIVATE_KEY_PEM=
KALSHI_TIMEOUT_SECONDS=15

# Writes fail closed. Keep false until demo verification and formal approval.
KALSHI_LIVE_WRITE_ENABLED=false
KALSHI_LIVE_CONFIRMATION_TOKEN=
